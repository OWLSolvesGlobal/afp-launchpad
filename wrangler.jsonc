{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afp-launchpad",
  "compatibility_date": "2026-07-26",

  // This Worker now has a script (a deliberate change from the previous
  // assets-only setup): it serves GET /api/catalog from KV and runs the
  // 5-minute cron that copies the Loyverse item list into KV. Every other request
  // falls through to static assets via env.ASSETS.fetch(), so SPA routing
  // and edge caching behave exactly as before.
  "main": "worker/entry.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Any URL that isn't a real file returns index.html with a 200.
    // This is what makes /shop/women and /product/lime-romper work on a
    // hard refresh or a shared link. Do NOT also add a /* splat rule to a
    // _redirects file — on Workers, redirects are applied even when a real
    // asset matches, so a splat there would hijack your JS and CSS.
    "not_found_handling": "single-page-application",

    // The Worker script only runs for requests that are NOT static assets
    // (i.e. /api/*), keeping asset serving free and cache-fast.
    "run_worker_first": ["/api/*"]
  },

  // Copies the Loyverse item list (items, sizes, prices, stock) into KV every
  // 5 minutes. Harmless until the AFPWebsite secret (the Loyverse access
  // token) is set: the sync logs that it is unconfigured and exits.
  // Sign-in for the owner's portal (Cloudflare Access). Neither value is a
  // secret. Left empty, every /api/admin/* request is refused.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://alo-fitness-pro.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Catalog snapshot store. Created 24 Nov 2026. If this binding is ever
  // removed the site keeps working on the bundled seed catalog.
  "kv_namespaces": [
    { "binding": "AFP_CATALOG", "id": "78d73e1a5ae24b9fa708ce321de3ceba" }
  ],

  // Orders database (D1), created 28 Nov 2026. Holds orders, their items,
  // the audit log and owner-entered settings. Schema lives in ./migrations;
  // apply new files with `npx wrangler d1 migrations apply afp-orders --remote`.
  // If this binding is removed the shop still browses; ordering returns
  // "not available right now".
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "afp-orders",
      "database_id": "849c1ff1-5d66-4ac4-ae25-7ce84960839a",
      "migrations_dir": "migrations"
    }
  ],

  // The Loyverse access token. It lives in the account's Secrets Store under
  // the name AFPWebsite; this binding is what lets the Worker read it
  // (`await env.AFPWebsite.get()`). The store id is not secret. If the token
  // is ever replaced, update the secret's value in the Secrets Store; nothing
  // here changes.
  // Private bucket for customers' payment proofs. No public access and no
  // custom domain: files are only ever read by the Worker, for an admin.
  "r2_buckets": [
    { "binding": "PROOFS", "bucket_name": "afp-order-proofs" }
  ],

  "secrets_store_secrets": [
    {
      "binding": "AFPWebsite",
      "store_id": "beb8798f2923435cb4a6ebd35e1f07b3",
      "secret_name": "AFPWebsite"
    }
  ],

  "observability": {
    "enabled": true
  }
}
