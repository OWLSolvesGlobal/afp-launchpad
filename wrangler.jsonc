{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afp-launchpad",
  "compatibility_date": "2026-07-26",

  // This Worker now has a script (a deliberate change from the previous
  // assets-only setup): it serves GET /api/catalog from KV and runs the
  // 5-minute cron that copies the Loyverse item list into KV. Every other request
  // falls through to static assets via env.ASSETS.fetch(), so SPA routing
  // and edge caching behave exactly as before.
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Any URL that isn't a real file returns index.html with a 200.
    // This is what makes /shop/women and /product/lime-romper work on a
    // hard refresh or a shared link. Do NOT also add a /* splat rule to a
    // _redirects file — on Workers, redirects are applied even when a real
    // asset matches, so a splat there would hijack your JS and CSS.
    "not_found_handling": "single-page-application",

    // The Worker script only runs for requests that are NOT static assets
    // (i.e. /api/*), keeping asset serving free and cache-fast.
    "run_worker_first": ["/api/*"]
  },

  // Copies the Loyverse item list (items, sizes, prices, stock) into KV every
  // 5 minutes. Harmless until the AFPWebsite secret (the Loyverse access
  // token) is set: the sync logs that it is unconfigured and exits.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Catalog snapshot store. Created 24 Nov 2026. If this binding is ever
  // removed the site keeps working on the bundled seed catalog.
  "kv_namespaces": [
    { "binding": "AFP_CATALOG", "id": "78d73e1a5ae24b9fa708ce321de3ceba" }
  ],

  "observability": {
    "enabled": true
  }
}
