{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afp-launchpad",
  "compatibility_date": "2026-07-26",

  // This Worker now has a script (a deliberate change from the previous
  // assets-only setup): it serves GET /api/catalog from KV and runs the
  // 5-minute cron that copies the Google Sheet into KV. Every other request
  // falls through to static assets via env.ASSETS.fetch(), so SPA routing
  // and edge caching behave exactly as before.
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Any URL that isn't a real file returns index.html with a 200.
    // This is what makes /shop/women and /product/lime-romper work on a
    // hard refresh or a shared link. Do NOT also add a /* splat rule to a
    // _redirects file — on Workers, redirects are applied even when a real
    // asset matches, so a splat there would hijack your JS and CSS.
    "not_found_handling": "single-page-application",

    // The Worker script only runs for requests that are NOT static assets
    // (i.e. /api/*), keeping asset serving free and cache-fast.
    "run_worker_first": ["/api/*"]
  },

  // Pulls the Google Sheet into KV every 5 minutes. Harmless until the
  // GOOGLE_SERVICE_ACCOUNT_JSON and CATALOG_SHEET_ID secrets are set — the
  // sync logs that it is unconfigured and exits.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // ONE-TIME SETUP — the catalog KV namespace does not exist yet.
  // Run:  npx wrangler kv namespace create AFP_CATALOG
  // then paste the returned id below and uncomment. Until then the site
  // serves the bundled seed catalog and the cron sync no-ops.
  // "kv_namespaces": [
  //   { "binding": "AFP_CATALOG", "id": "PASTE_NAMESPACE_ID_HERE" }
  // ],

  "observability": {
    "enabled": true
  }
}
